<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- <PublishAot>true</PublishAot> -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
		<!-- NON-AOT -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishReadyToRun>false</PublishReadyToRun>
		<!-- Size -->
		<DebugType>none</DebugType>
		<EventSourceSupport>false</EventSourceSupport>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WOWCAM.Core\WOWCAM.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Condition="'$(RuntimeIdentifier)' == 'win-x64'"
			Include="..\..\..\wowcam.xml.sample-win" Link="wowcam.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Condition="'$(RuntimeIdentifier)' == 'osx-arm64'"
			Include="..\..\..\wowcam.xml.sample-mac" Link="wowcam.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>